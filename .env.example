FLASK_SECRET_KEY=change-me
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Project Settings -> API в панели Supabase
SUPABASE_URL=
# Project Settings -> API -> service_role (секретный, только для backend! не для фронтенда)
SUPABASE_SERVICE_KEY=

# platform.openai.com -> API keys. Нужен только для чатов в режиме gpt —
# без него всё остальное продолжает работать, автоответ просто не придёт.
OPENAI_API_KEY=
# необязательно, по умолчанию gpt-4o-mini
OPENAI_MODEL=
